# ==============================================================================
# ReSourceX Backend Environment Variables Configuration Template
# Copy this file to .env and replace with secure values for production
# ==============================================================================

# Environment: "development" or "production"
ENVIRONMENT=production

# Application Secret Key (Generate a random 32+ character hex string in production)
# Example: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-key-in-production

# JWT Algorithm & Token Expiry (in minutes, 1440 = 24 hours)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection URL
# SQLite (Local): sqlite:///./waste2raw.db
# PostgreSQL (Production/Supabase/Render): postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./waste2raw.db

# Storage Directory for Uploads
UPLOAD_DIR=./uploads

# Default Super Admin Account (created on initial startup if non-existent)
ADMIN_EMAIL=admin@waste2raw.com
ADMIN_PASSWORD=ChangeMeAdmin2026!

# Allowed CORS Origins (comma-separated URLs, or * in development)
# In production, set this to your exact frontend domain(s)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
